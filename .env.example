# คัดลอกเป็น .env แล้วเติมค่า — ห้าม commit .env
#
# เลือกอย่างใดอย่างหนึ่ง:
#   1) ใส่ ANTHROPIC_API_KEY (จาก console.anthropic.com — คิดเงินตาม usage)
#   2) เว้นว่างไว้ แล้วติดตั้ง + login Claude Code ในเครื่อง — แอพจะเรียก
#      `claude -p` ให้อัตโนมัติ (ใช้ subscription ของคุณ, สำหรับใช้ส่วนตัวเท่านั้น)
ANTHROPIC_API_KEY=

# บังคับโหมด agent: auto (ค่าเริ่มต้น) | api | claude-cli
PROMPTCUT_AGENT=auto
# path ของ Claude Code CLI ถ้าไม่ได้อยู่ใน PATH
PROMPTCUT_CLI_BIN=claude

PROMPTCUT_MODEL=claude-sonnet-5
PROMPTCUT_BIND=0.0.0.0:8080
RUST_LOG=info,promptcut_server=debug
